# ==============================================================================
# Saints Crew — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit it.
#
# TWO CLASSES OF VARIABLE — the distinction matters:
#
#   VITE_*          CLIENT-SAFE. Vite inlines these into the JavaScript bundle at
#                   build time. Anyone can read them by opening devtools. Only ever
#                   put publishable/public keys here.
#
#   everything else SERVER-ONLY. These are Supabase Edge Function secrets, set with
#                   `supabase secrets set NAME=value` (or in the Supabase dashboard
#                   under Edge Functions → Secrets). They must NEVER be prefixed
#                   with VITE_ and must never appear in `src/`.
#
# CLAUDE.md §2: "The React app never calls these third-party APIs directly with a
# secret key." If you find yourself wanting a secret in the client, the answer is
# an Edge Function.
# ==============================================================================


# ------------------------------------------------------------------------------
# CLIENT-SAFE  (bundled into the browser build)
# ------------------------------------------------------------------------------

# Supabase project URL. Dashboard → Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Dashboard → Project Settings → API → anon public.
# Safe to ship: it grants no more access than Row Level Security allows, which is
# exactly why RLS is mandatory on every customer/order table (CLAUDE.md §6).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay *Key ID* only — the public half of the pair, needed by Razorpay's
# browser checkout script. The Key Secret is server-only, see below.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx


# ------------------------------------------------------------------------------
# SERVER-ONLY  (Supabase Edge Function secrets — NOT prefixed with VITE_)
#
#   supabase secrets set RAZORPAY_KEY_SECRET=...
# ------------------------------------------------------------------------------

# Razorpay Key Secret. Signs order creation and verifies payment signatures.
# Leaking this lets an attacker forge paid orders.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay webhook signing secret, for verifying webhook callbacks server-side.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Anthropic API key — used only by the Style Assistant Edge Function
# (CLAUDE.md §5.6). Billed per call; never expose to the client.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Supabase service-role key. Bypasses RLS entirely — Edge Functions use it to
# write orders and read the full catalog. Treat as root credentials.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL  (server-only)
#
# One set of SMTP credentials serves both email paths — no separate email vendor
# (DECISIONS.md, 2026-08-27):
#
#   1. Auth emails (signup confirmation, password reset) — configured in the
#      Supabase dashboard under Authentication → Emails → SMTP Settings. Not
#      read from here; Supabase sends those itself. Required for production:
#      the built-in Supabase sender is rate-limited to a few emails per hour.
#
#   2. Order confirmation emails (§5.5) — sent by an Edge Function, which reads
#      the values below.
#
# Use the SMTP host for the brand mailbox (Zoho, Google Workspace, whatever the
# domain's email is on). Blocked until that mailbox exists — the same gap that
# leaves siteConfig.contact.email pending.
# ------------------------------------------------------------------------------

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=orders@your-domain.com
SMTP_PASSWORD=your-smtp-password
# The From: address customers see. Should match a real, monitored mailbox.
SMTP_FROM_EMAIL=orders@your-domain.com
SMTP_FROM_NAME=Saints Crew
