# Copy this file to .env and fill in the four values from your EmailJS dashboard.
#
# These are NOT secrets. Vite inlines every VITE_* value into the built
# JavaScript, so anyone can read them in devtools. The EmailJS public key is
# designed to be public. The real protection is the allowed-origins list under
# Account > Security in the EmailJS dashboard. .env is gitignored for tidiness,
# not for security.

# Email Services > your service
VITE_EMAILJS_SERVICE_ID=

# Account > API Keys > Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Email Templates > the two template IDs
VITE_EMAILJS_TEMPLATE_CONFIRMATION=
VITE_EMAILJS_TEMPLATE_REMINDER=
